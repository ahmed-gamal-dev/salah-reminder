{
  "name": "salah-reminder",
  "productName": "Salah Reminder",
  "version": "0.1.1",
  "description": "Offline prayer times and adhkar reminders for macOS, Windows and Linux — مواقيت الصلاة وتذكير الأذكار",
  "main": "src/main/index.js",
  "author": "Ahmed Gamal <44279509+ahmed-gamal-dev@users.noreply.github.com>",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "vitest run",
    "icons": "node scripts/gen-icons.js",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "sounds": "node scripts/gen-sounds.js",
    "build:extension": "node scripts/build-extension.js",
    "zip:extension": "node scripts/build-extension.js --zip"
  },
  "dependencies": {
    "adhan": "^4.4.6"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "build": {
    "appId": "io.github.salah-reminder",
    "productName": "Salah Reminder",
    "files": [
      "src/**/*",
      "data/**/*",
      "assets/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.lifestyle",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/icon.png",
      "extendInfo": {
        "LSUIElement": true
      }
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "assets/icon.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "assets/icon.png",
      "maintainer": "Ahmed Gamal <44279509+ahmed-gamal-dev@users.noreply.github.com>"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "afterPack": "build/adhoc-sign.js"
  }
}
